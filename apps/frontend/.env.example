# Snowball frontend URL (iframe source)
NEXT_PUBLIC_SNOWBALL_URL=https://reports.beansinfo.com
# Optional: comma-separated list of allowed parent origins for iframe postMessage
NEXT_PUBLIC_IFRAME_PARENT_ORIGINS=https://www.beansinfo.com
