# ============================================
# Docker Compose 环境变量配置
# 复制此文件为 .env 使用: cp .env.docker .env
# ============================================

# PostgreSQL 配置
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ratel_mind
DB_USER=ratel
DB_PASSWORD=ratel123

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 安全配置
SECRET_KEY=snowball-docker-secret-key-change-in-production

# 前端 API 配置
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WEB_API_URL=http://localhost:8003
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003
NEXT_PUBLIC_SNOWBALL_URL=http://localhost:3000
